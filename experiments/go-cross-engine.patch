diff --git a/apps/go/bind.go b/apps/go/bind.go
new file mode 100644
index 0000000..7a1dded
--- /dev/null
+++ b/apps/go/bind.go
@@ -0,0 +1,30 @@
+package main
+
+import (
+	"strconv"
+	"strings"
+)
+
+// Queries in this app use ? only for parameters, never inside SQL literals.
+// Keep the MySQL and SQLite syntax and number those parameters for PostgreSQL.
+func (a *app) bind(query string) string {
+	if a.dialect != "postgres" {
+		return query
+	}
+	var result strings.Builder
+	result.Grow(len(query) + 3*strings.Count(query, "?"))
+	var digits [20]byte
+	parameter := int64(1)
+	for {
+		i := strings.IndexByte(query, '?')
+		if i < 0 {
+			result.WriteString(query)
+			return result.String()
+		}
+		result.WriteString(query[:i])
+		result.WriteByte('$')
+		result.Write(strconv.AppendInt(digits[:0], parameter, 10))
+		parameter++
+		query = query[i+1:]
+	}
+}
