new file mode 100755
index 0000000..f3c038d
--- /dev/null
+++ b/bench/database_matrix.py
@@ -0,0 +1,502 @@
+#!/usr/bin/env python3
+"""Compare one Go binary against disposable MySQL, MariaDB and PostgreSQL fixtures."""
+import argparse
+from contextlib import contextmanager, ExitStack
+import hashlib
+import json
+import os
+from pathlib import Path
+import platform
+import random
+import re
+import secrets
+import select
+import subprocess as sp
+import sys
+import tempfile
+import threading
+import time
+
+import matrix
+
+
+ENGINES = ('mysql', 'mariadb', 'postgres')
+REQUESTED_VERSIONS = {'mysql': '9.7.4', 'mariadb': '12.3.4', 'postgres': '19.0'}
+DEFAULT_IMAGES = {
+    'mysql': 'docker.io/library/mysql:9.7.4',
+    # The requested 12.3.4 official tag is unavailable; record this fallback.
+    'mariadb': 'docker.io/library/mariadb:12.3.3',
+    'postgres': 'docker.io/library/postgres:19.0',
+}
+CGROUP_ROOT = Path('/sys/fs/cgroup')
+
+
+def executable_hash():
+    with matrix.APPS['go'].open('rb') as executable:
+        return hashlib.file_digest(executable, 'sha256').hexdigest()
+
+
+def cpu_set(spec):
+    cpus = set()
+    for item in spec.split(','):
+        parts = item.split('-')
+        if len(parts) == 1 and parts[0].isdigit():
+            cpus.add(int(parts[0]))
+        elif len(parts) == 2 and all(part.isdigit() for part in parts):
+            start, end = map(int, parts)
+            if end < start:
+                raise ValueError('descending CPU range')
+            cpus.update(range(start, end + 1))
+        else:
+            raise ValueError('invalid CPU list')
+    if not cpus:
+        raise ValueError('empty CPU list')
+    return cpus
+
+
+def cgroup_for_pid(pid):
+    lines = Path(f'/proc/{pid}/cgroup').read_text().splitlines()
+    groups = [line.split(':', 2)[2] for line in lines if line.startswith('0::')]
+    if len(groups) != 1 or groups[0] == '/':
+        raise RuntimeError('database does not have a dedicated cgroup v2')
+    group = (CGROUP_ROOT / groups[0].lstrip('/')).resolve()
+    if not group.is_relative_to(CGROUP_ROOT) or not (group / 'memory.stat').is_file():
+        raise RuntimeError('database cgroup v2 memory accounting is unavailable')
+    return group
+
+
+def cgroup_pids(group):
+    pids = set()
+    for path in group.rglob('cgroup.procs'):
+        try:
+            pids.update(map(int, path.read_text().split()))
+        except FileNotFoundError:
+            continue  # A short-lived child cgroup exited during enumeration.
+    return pids
+
+
+def task_affinities(pid):
+    try:
+        tasks = list(Path(f'/proc/{pid}/task').iterdir())
+    except FileNotFoundError:
+        return []
+    affinities = []
+    for task in tasks:
+        try:
+            lines = (task / 'status').read_text().splitlines()
+        except FileNotFoundError:
+            continue
+        value = next(line.split(':', 1)[1].strip() for line in lines
+                     if line.startswith('Cpus_allowed_list:'))
+        affinities.append(cpu_set(value))
+    return affinities
+
+
+def pin_database(cid, cpus):
+    # Pin the final container process first. Existing workers are then pinned
+    # individually; new threads and PostgreSQL backends inherit from their parent.
+    pid = int(matrix.text('podman', 'inspect', cid, '--format', '{{.State.Pid}}'))
+    if pid <= 0:
+        raise RuntimeError('database container is not running')
+    group = cgroup_for_pid(pid)
+    expected = cpu_set(cpus)
+    deadline = time.monotonic() + 15
+    while time.monotonic() < deadline:
+        pids = cgroup_pids(group)
+        if pid not in pids:
+            raise RuntimeError('final database process left its cgroup')
+        for worker in sorted(pids, key=lambda value: (value != pid, value)):
+            affinities = task_affinities(worker)
+            if affinities and any(value != expected for value in affinities):
+                result = sp.run(['podman', 'unshare', 'taskset', '-apc', cpus, str(worker)],
+                                stdout=sp.DEVNULL, stderr=sp.PIPE, text=True)
+                if result.returncode and Path(f'/proc/{worker}').exists():
+                    raise RuntimeError(f'could not pin database PID {worker}: {result.stderr.strip()}')
+        pids = cgroup_pids(group)
+        affinities = [affinity for worker in pids for affinity in task_affinities(worker)]
+        if pid in pids and affinities and all(value == expected for value in affinities):
+            return group, {'processes_checked': len(pids), 'threads_checked': len(affinities),
+                           'method': 'cgroup processes and threads; children inherit affinity'}
+        time.sleep(0.05)
+    raise RuntimeError('could not pin all database cgroup threads')
+
+
+def memory_sample(app_pid, group):
+    app = matrix.rss_kib({'app': app_pid})['app']
+    stats = dict(line.split() for line in (group / 'memory.stat').read_text().splitlines())
+    anon, shmem = int(stats['anon']), int(stats['shmem'])
+    current = int((group / 'memory.current').read_text())
+    if app <= 0 or anon + shmem <= 0:
+        raise RuntimeError('could not sample application or database memory')
+    return {'app_rss_kib': app, 'database_cgroup_anon_bytes': anon,
+            'database_cgroup_shmem_bytes': shmem,
+            'database_cgroup_anon_plus_shmem_bytes': anon + shmem,
+            'database_cgroup_memory_current_bytes': current}
+
+
+class PeakMemory:
+    """Sample process VmRSS and hierarchical cgroup memory; never sum process RSS."""
+    def __init__(self, app_pid, group):
+        self.app_pid = app_pid
+        self.group = group
+        self.stop = threading.Event()
+        self.thread = threading.Thread(target=self.sample)
+        self.error = None
+        self.peaks = None
+        self.samples = 0
+
+    def sample(self):
+        try:
+            while not self.stop.wait(0.1):
+                current = memory_sample(self.app_pid, self.group)
+                for key, value in current.items():
+                    self.peaks[key] = max(self.peaks[key], value)
+                self.samples += 1
+        except Exception as exc:
+            self.error = exc
+
+    def __enter__(self):
+        self.peaks = memory_sample(self.app_pid, self.group)
+        self.samples = 1
+        self.thread.start()
+        return self
+
+    def __exit__(self, *_):
+        self.stop.set()
+        self.thread.join()
+        if self.error is not None:
+            raise RuntimeError('memory sampling failed') from self.error
+
+
+def run_logged(cmd, work, *, env=None, input=None, cwd=None, timeout=None):
+    with (work / 'client.log').open('a', encoding='utf-8') as log:
+        result = sp.run(cmd, cwd=cwd, env=env, input=input, text=True,
+                        stdout=sp.PIPE, stderr=log, timeout=timeout)
+    if result.returncode:
+        raise RuntimeError(f'{Path(cmd[0]).name} exited with status {result.returncode}')
+    return result.stdout.strip()
+
+
+def private_env_file(work, variables):
+    path = work / 'database.env'
+    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+    with os.fdopen(fd, 'w', encoding='utf-8') as stream:
+        for key, value in variables.items():
+            print(f'{key}={value}', file=stream)
+    return path
+
+
+@contextmanager
+def logged_container(image, config, work, name, server_args=()):
+    with matrix.container(image, config, server_args) as cid:
+        try:
+            yield cid
+        except BaseException:
+            with (work / f'{name}.log').open('ab') as log:
+                sp.run(['podman', 'logs', cid], stdout=log, stderr=sp.STDOUT, check=False)
+            raise
+
+
+def sql_command(engine, image, cid, port, password, *, published=False):
+    if engine == 'postgres':
+        client, variable, user, internal_port = 'psql', 'PGPASSWORD', 'postgres', 5432
+        client_args = ['-X', '-q', '-A', '-t', '-F', '\t', '-v', 'ON_ERROR_STOP=1', '-w',
+                       '-h', '127.0.0.1', '-p', str(port if published else internal_port),
+                       '-U', user, '-d', 'kotatsu']
+    else:
+        client = 'mysql' if engine == 'mysql' else 'mariadb'
+        variable, internal_port = 'MYSQL_PWD', 3306
+        client_args = ['--no-defaults', '--protocol=tcp', '--connect-timeout=2',
+                       '-h', '127.0.0.1', '-P', str(port if published else internal_port),
+                       '-u', 'root', '--batch', '--skip-column-names', 'kotatsu']
+    if published:
+        # A separate host-network client proves authentication through the actual
+        # loopback-published port, without entering the measured DB cgroup.
+        cmd = ['podman', 'run', '-i', '--pull=never', '--rm', '--network=host',
+               '--entrypoint', client, '-e', variable]
+        if engine == 'postgres':
+            cmd.extend(['-e', 'PGSSLMODE', '-e', 'PGCONNECT_TIMEOUT'])
+        cmd.append(image)
+    else:
+        cmd = ['podman', 'exec', '-i', '-e', variable]
+        if engine == 'postgres':
+            cmd.extend(['-e', 'PGSSLMODE', '-e', 'PGCONNECT_TIMEOUT'])
+        cmd.extend([cid, client])
+    env = dict(os.environ, **{variable: password, 'PGSSLMODE': 'disable', 'PGCONNECT_TIMEOUT': '2'})
+    return [*cmd, *client_args], env
+
+
+def probe_ready(cmd, env):
+    try:
+        return sp.run(cmd, env=env, input='SELECT 1;\n', text=True, stdout=sp.DEVNULL,
+                      stderr=sp.DEVNULL, timeout=5).returncode == 0
+    except sp.TimeoutExpired:
+        return False
+
+
+def version_details(engine, image, version, allow_fallback):
+    if engine == 'mariadb':
+        match = re.search(r'(\d+\.\d+\.\d+)(?:-MariaDB)', version, re.IGNORECASE)
+    else:
+        match = re.search(r'\d+\.\d+(?:\.\d+)?', version)
+    if not match:
+        raise RuntimeError(f'unrecognized {engine} version: {version}')
+    actual = match.group(1) if engine == 'mariadb' else match.group()
+    expected = REQUESTED_VERSIONS[engine]
+    parts = tuple(map(int, actual.split('.')))
+    expected_parts = tuple(map(int, expected.split('.')))
+    fallback = parts[:len(expected_parts)] != expected_parts
+    default_maria_fallback = (engine == 'mariadb' and image == DEFAULT_IMAGES[engine]
+                              and actual == '12.3.3')
+    if fallback and not (allow_fallback or default_maria_fallback):
+        raise RuntimeError(f'{engine} version {version} differs from {expected}; '
+                           'explicitly pass --allow-version-fallback to use it')
+    if fallback:
+        reason = ('official MariaDB 12.3.4 tag unavailable; default is 12.3.3'
+                  if default_maria_fallback else 'explicit --allow-version-fallback')
+        print(f'Version fallback: {engine} requested {expected}, got {version} ({reason})',
+              file=sys.stderr, flush=True)
+    else:
+        reason = None
+    return {'requested': expected, 'server': version, 'numeric': actual,
+            'requested_major_matches': parts[0] == expected_parts[0],
+            'fallback': fallback, 'fallback_reason': reason}
+
+
+def database_fixture(stack, args, engine, work):
+    image = getattr(args, engine + '_image')
+    password, admin_password = secrets.token_hex(24), secrets.token_hex(24)
+    if engine == 'postgres':
+        variables = {'POSTGRES_USER': 'postgres', 'POSTGRES_PASSWORD': admin_password,
+                     'POSTGRES_DB': 'kotatsu'}
+        internal_port = 5432
+        server_args = ['postgres', '-c', 'fsync=on', '-c', 'synchronous_commit=on',
+                       '-c', 'full_page_writes=on', '-c', 'default_transaction_isolation=read committed']
+    else:
+        prefix = 'MYSQL' if engine == 'mysql' else 'MARIADB'
+        variables = {prefix + '_ROOT_PASSWORD': admin_password, prefix + '_ROOT_HOST': '%',
+                     prefix + '_DATABASE': 'kotatsu', prefix + '_USER': 'kotatsu',
+                     prefix + '_PASSWORD': password}
+        internal_port = 3306
+        server_args = ['--skip-log-bin', '--innodb-flush-log-at-trx-commit=1',
+                       '--transaction-isolation=READ-COMMITTED']
+    env_file = private_env_file(work, variables)
+    cid = stack.enter_context(logged_container(image, ['-p', f'127.0.0.1::{internal_port}',
+                                                        '--env-file', str(env_file)],
+                                                work, 'database', server_args))
+    port = matrix.published(cid, internal_port)
+    internal_cmd, sql_env = sql_command(engine, image, cid, port, admin_password)
+    # Official images start temporary initialization servers without TCP. Never
+    # mistake their local socket for the final serving process.
+    matrix.ready(lambda: probe_ready(internal_cmd, sql_env), engine + ' final TCP server', 180)
+    cmd, sql_env = sql_command(engine, image, cid, port, admin_password, published=True)
+    if engine == 'postgres':
+        query = ("SELECT current_setting('server_version'), current_setting('fsync'), "
+                 "current_setting('synchronous_commit'), current_setting('full_page_writes'), "
+                 "current_setting('default_transaction_isolation'), current_setting('transaction_isolation'), "
+                 "pg_size_bytes(current_setting('shared_buffers')), current_setting('max_connections'), "
+                 "current_setting('data_directory');\n")
+        values = run_logged(cmd, work, env=sql_env, input=query, timeout=60).split('\t')
+        if len(values) != 9:
+            raise RuntimeError('unexpected PostgreSQL settings response')
+        version, fsync, sync, pages, default_isolation, session_isolation, buffers, max_conn, data_dir = values
+        if (fsync, sync, pages) != ('on', 'on', 'on') or any(
+                value.lower() != 'read committed' for value in (default_isolation, session_isolation)):
+            raise RuntimeError('PostgreSQL durability or isolation settings are incorrect')
+        settings = {'fsync': fsync, 'synchronous_commit': sync, 'full_page_writes': pages,
+                    'default_transaction_isolation': default_isolation, 'transaction_isolation': session_isolation,
+                    'shared_buffers_bytes': int(buffers), 'max_connections': int(max_conn),
+                    'data_directory': data_dir}
+        # The app owns its disposable database but is not the bootstrap superuser.
+        create_role = (f"CREATE ROLE kotatsu LOGIN PASSWORD '{password}'; "
+                       'ALTER DATABASE kotatsu OWNER TO kotatsu; GRANT ALL ON SCHEMA public TO kotatsu;\n')
+        run_logged(cmd, work, env=sql_env, input=create_role, timeout=60)
+        dialect = 'postgres'
+    else:
+        isolation = 'transaction_isolation' if engine == 'mysql' else 'tx_isolation'
+        query = ('SELECT VERSION(), @@version_comment, @@GLOBAL.default_storage_engine, '
+                 '@@GLOBAL.innodb_flush_log_at_trx_commit, @@GLOBAL.log_bin, '
+                 f'@@GLOBAL.{isolation}, @@SESSION.{isolation}, @@GLOBAL.innodb_buffer_pool_size, '
+                 '@@GLOBAL.max_connections, @@GLOBAL.sync_binlog;\n')
+        values = run_logged(cmd, work, env=sql_env, input=query, timeout=60).split('\t')
+        if len(values) != 10:
+            raise RuntimeError(f'unexpected {engine} settings response')
+        version, comment, storage, flush, log_bin, global_isolation, session_isolation, buffers, max_conn, sync = values
+        is_mariadb = 'mariadb' in (version + ' ' + comment).lower()
+        if is_mariadb != (engine == 'mariadb'):
+            raise RuntimeError(f'{engine} image returned an unexpected server vendor: {version} {comment}')
+        if (storage.lower() != 'innodb' or flush != '1' or log_bin != '0' or
+                any(value.upper().replace(' ', '-') != 'READ-COMMITTED'
+                    for value in (global_isolation, session_isolation))):
+            raise RuntimeError(f'{engine} durability, binary logging, engine or isolation settings are incorrect')
+        settings = {'version_comment': comment, 'default_storage_engine': storage,
+                    'innodb_flush_log_at_trx_commit': int(flush), 'log_bin': int(log_bin),
+                    'global_transaction_isolation': global_isolation, 'session_transaction_isolation': session_isolation,
+                    'innodb_buffer_pool_size_bytes': int(buffers), 'max_connections': int(max_conn),
+                    'sync_binlog': int(sync)}
+        dialect = 'mysql'
+    version_info = version_details(engine, image, version, args.allow_version_fallback)
+    image_id = matrix.text('podman', 'inspect', cid, '--format', '{{.Image}}')
+    image_digest = matrix.text('podman', 'image', 'inspect', image_id, '--format', '{{.Digest}}')
+    if not image_id or not image_digest:
+        raise RuntimeError('database image ID or digest unavailable')
+    group, affinity = pin_database(cid, args.db_cpus)
+    db_env = {'DATABASE_DIALECT': dialect, 'DATABASE_HOST': '127.0.0.1', 'DATABASE_PORT': str(port),
+              'DATABASE_NAME': 'kotatsu', 'DATABASE_USER': 'kotatsu', 'DATABASE_PASSWORD': password}
+    info = {'image': image, 'image_id': image_id, 'image_digest': image_digest,
+            'version': version_info, 'settings': settings, 'affinity_verification': affinity}
+    return db_env, info, group
+
+
+def measure_memory(args, work, env, group):
+    cmd = matrix.load_command(args, env['BASE_URL']) + ['--pause-after-seed']
+    with (work / 'client.log').open('a', encoding='utf-8') as log:
+        with ExitStack() as cleanup:
+            with matrix.application('go', work, env, args.app_cpus):
+                client = cleanup.enter_context(sp.Popen(cmd, stdin=sp.PIPE, stdout=sp.PIPE,
+                                                        stderr=log, text=True))
+                cleanup.callback(lambda: client.kill() if client.poll() is None else None)
+                if not select.select([client.stdout], [], [], 120)[0] or client.stdout.readline() != 'SEEDED\n':
+                    raise RuntimeError('client did not confirm its seeded and verified fixture')
+            # JWTs and the database survive; the measured app never hashes a password.
+            with matrix.application('go', work, env, args.app_cpus) as app:
+                time.sleep(3)
+                idle = memory_sample(app.pid, group)
+                with PeakMemory(app.pid, group) as peak:
+                    output, _ = client.communicate(input='\n', timeout=300)
+                    if client.returncode:
+                        raise RuntimeError(f'load client exited with status {client.returncode}')
+                load = json.loads(output)
+                time.sleep(10)
+                after = memory_sample(app.pid, group)
+    return {'load': load, 'memory': {'idle': idle, 'sync_sampled_peak': peak.peaks, 'after_sync': after,
+                                     'idle_seconds': 3, 'after_sync_seconds': 10,
+                                     'sample_interval_ms': 100, 'peak_sample_count': peak.samples,
+                                     'app_metric': 'Linux process VmRSS, KiB',
+                                     'database_metric': 'hierarchical cgroup v2 anon plus shmem, bytes; '
+                                                        'memory.current separately includes other charges'}}
+
+
+def run_cell(args, engine, trial, position, work, app_hash):
+    port = matrix.fresh_port()
+    base = f'http://127.0.0.1:{port}'
+    env = dict(os.environ, PORT=str(port), BIND_HOST='127.0.0.1', BASE_URL=base,
+               JWT_SECRET=secrets.token_hex(32), ALLOW_NEW_REGISTER='true',
+               AUTH_RATE_LIMIT='1000', MAIL_PROVIDER='console')
+    record = {'app': 'go', 'app_sha256': app_hash, 'database': engine, 'mode': args.mode,
+              'trial': trial, 'order_position': position, 'order_seed': 100 + trial,
+              'cpu_affinity': {'app': args.app_cpus, 'database': args.db_cpus,
+                               'client_and_runner': args.client_cpus},
+              'host': platform.uname().machine, 'kernel': platform.release(), 'auth_rate_limit': 1000,
+              'profile': {'clients': args.clients, 'library': args.library, 'warmup': args.warmup,
+                          'rounds': args.rounds, 'neighbour_library': args.neighbour_library,
+                          'trials': args.trials}}
+    with ExitStack() as stack:
+        db_env, record['database_fixture'], group = database_fixture(stack, args, engine, work)
+        env.update(db_env)
+        if args.mode == 'verify':
+            mail = stack.enter_context(logged_container(args.mailpit_image,
+                ['-p', '127.0.0.1::8025', '-p', '127.0.0.1::1025'], work, 'mailpit'))
+            mail_url = f'http://127.0.0.1:{matrix.published(mail, 8025)}'
+            env.update(MAIL_PROVIDER='smtp', SMTP_HOST='127.0.0.1', SMTP_PORT=str(matrix.published(mail, 1025)),
+                       SMTP_USERNAME='', SMTP_PASSWORD='', SMTP_FROM='kotatsu@example.invalid')
+            matrix.ready(lambda: matrix.http_ok(mail_url + '/api/v1/messages'), 'Mailpit')
+        if args.mode == 'memory':
+            record.update(measure_memory(args, work, env, group))
+            return record
+        app = stack.enter_context(matrix.application('go', work, env, args.app_cpus))
+        if args.mode == 'verify':
+            checks = []
+            for suite in ('sync', 'history-policy', 'recovery'):
+                cmd = [matrix.BUILD / 'contract', 'verify', '--base-url', base, '--suite', suite]
+                if suite == 'recovery':
+                    cmd.extend(['--mailpit-url', mail_url])
+                checks.append(run_logged(matrix.pinned(args.client_cpus, cmd), work,
+                                         cwd=matrix.ROOT / 'contract-tests', timeout=300))
+            matrix.check_endpoints(port)
+            record['checks'] = checks + ['public endpoints verified']
+        else:
+            with PeakMemory(app.pid, group) as peak:
+                record['load'] = json.loads(run_logged(matrix.load_command(args, base), work, timeout=600))
+            record['setup_inclusive_sampled_peak_memory'] = peak.peaks
+            record['sample_interval_ms'] = 100
+            record['peak_sample_count'] = peak.samples
+    return record
+
+
+def save_failure_logs(work):
+    paths = [work / name for name in ('server.log', 'client.log', 'database.log', 'mailpit.log')]
+    if not any(path.exists() for path in paths):
+        return
+    with tempfile.NamedTemporaryFile(dir=matrix.BUILD, prefix='failed-database-', suffix='.log', delete=False) as log:
+        for path in paths:
+            if path.exists():
+                log.write(f'\n--- {path.name} ---\n'.encode())
+                log.write(path.read_bytes())
+        print('Private diagnostic log:', log.name, file=sys.stderr, flush=True)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('mode', choices=('verify', 'load', 'memory'))
+    parser.add_argument('--engines', '--engine', nargs='+', choices=ENGINES, default=list(ENGINES))
+    for engine in ENGINES:
+        parser.add_argument('--' + engine + '-image', default=DEFAULT_IMAGES[engine])
+    parser.add_argument('--mailpit-image', default=matrix.MAIL)
+    parser.add_argument('--allow-version-fallback', action='store_true',
+                        help='explicitly permit and record other server versions')
+    parser.add_argument('--trials', type=int, default=3)
+    parser.add_argument('--clients', type=int, default=4)
+    parser.add_argument('--library', type=int, default=50)
+    parser.add_argument('--warmup', type=int, default=10)
+    parser.add_argument('--rounds', type=int, default=50)
+    parser.add_argument('--neighbour-library', type=int, default=None,
+                        help='load only; default 500 for load, 0 otherwise')
+    parser.add_argument('--app-cpus', default='0-3')
+    parser.add_argument('--db-cpus', default='4-5')
+    parser.add_argument('--client-cpus', default='6-7')
+    parser.add_argument('--output', type=Path, help='new JSONL output; existing files are never overwritten')
+    args = parser.parse_args()
+    if min(args.trials, args.clients, args.library, args.rounds) < 1 or args.warmup < 0:
+        parser.error('trials, clients, library and rounds must be positive; warmup must be nonnegative')
+    if args.neighbour_library is None:
+        args.neighbour_library = 500 if args.mode == 'load' else 0
+    if args.neighbour_library < 0 or (args.mode != 'load' and args.neighbour_library):
+        parser.error('neighbour-library must be nonnegative and is available only for load')
+    if len(args.engines) != len(set(args.engines)):
+        parser.error('engines must not be repeated')
+    try:
+        app_cpus, db_cpus, client_cpus = map(cpu_set, (args.app_cpus, args.db_cpus, args.client_cpus))
+    except ValueError as exc:
+        parser.error(f'invalid CPU affinity: {exc}')
+    if app_cpus & db_cpus or app_cpus & client_cpus or db_cpus & client_cpus:
+        parser.error('app, database and client CPU lists must be disjoint')
+    # Keep orchestration, sampling and the Python endpoint client off the
+    # application and database cores too; child taskset calls select their CPUs.
+    os.sched_setaffinity(0, client_cpus)
+    matrix.BUILD.mkdir(parents=True, exist_ok=True)
+    if args.output is None:
+        args.output = matrix.BUILD / f'database-{args.mode}-{time.strftime("%Y%m%d-%H%M%S")}-{secrets.token_hex(4)}.jsonl'
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    app_hash = executable_hash()
+    print('Output:', args.output, file=sys.stderr, flush=True)
+    with args.output.open('x', encoding='utf-8') as output:
+        for trial in range(1, args.trials + 1):
+            engines = [engine for engine in ENGINES if engine in args.engines]
+            random.Random(100 + trial).shuffle(engines)
+            for position, engine in enumerate(engines, 1):
+                if executable_hash() != app_hash:
+                    raise RuntimeError('Go executable changed during the comparison')
+                print(f'{args.mode} go/{engine} trial {trial}', file=sys.stderr, flush=True)
+                with tempfile.TemporaryDirectory(dir=matrix.BUILD, prefix='database-fixture-') as tmp:
+                    work = Path(tmp)
+                    try:
+                        record = run_cell(args, engine, trial, position, work, app_hash)
+                    except Exception:
+                        save_failure_logs(work)
+                        raise
+                    print(json.dumps(record, separators=(',', ':')), file=output, flush=True)
+
+
+if __name__ == '__main__':
+    main()
