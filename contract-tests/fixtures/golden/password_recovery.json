{
  "story": "password_recovery",
  "steps": [
    {
      "name": "Given a reader creates an account",
      "method": "POST",
      "path": "/auth",
      "status": 200,
      "body_kind": "json",
      "body": {
        "token": "[REDACTED]"
      }
    },
    {
      "name": "When the reader supplies the wrong password",
      "method": "POST",
      "path": "/auth",
      "status": 400,
      "body_kind": "text",
      "body": "Wrong password"
    },
    {
      "name": "When the reader requests password recovery",
      "method": "POST",
      "path": "/forgot-password",
      "status": 200,
      "body_kind": "text",
      "body": "A password reset email was sent"
    },
    {
      "name": "And the reader changes password using the delivered token",
      "method": "POST",
      "path": "/reset-password",
      "status": 200,
      "body_kind": "text",
      "body": "Password has been reset successfully"
    },
    {
      "name": "Then the same reset token cannot be used again",
      "method": "POST",
      "path": "/reset-password",
      "status": 400,
      "body_kind": "text",
      "body": "Invalid or expired token"
    },
    {
      "name": "And the previous password no longer works",
      "method": "POST",
      "path": "/auth",
      "status": 400,
      "body_kind": "text",
      "body": "Wrong password"
    },
    {
      "name": "And the new password signs the reader in",
      "method": "POST",
      "path": "/auth",
      "status": 200,
      "body_kind": "json",
      "body": {
        "token": "[REDACTED]"
      }
    },
    {
      "name": "And the new session can read the account's history",
      "method": "GET",
      "path": "/resource/history",
      "status": 200,
      "body_kind": "json",
      "body": {
        "history": [],
        "timestamp": 0
      }
    }
  ]
}
