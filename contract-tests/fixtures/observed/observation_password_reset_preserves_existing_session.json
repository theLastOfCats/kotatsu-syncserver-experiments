{
  "story": "observation_password_reset_preserves_existing_session",
  "steps": [
    {
      "name": "Given the reader requests a replacement reset email",
      "method": "POST",
      "path": "/forgot-password",
      "status": 200,
      "body_kind": "text",
      "body": "A password reset email was sent"
    },
    {
      "name": "When the reader resets the password with the replacement token",
      "method": "POST",
      "path": "/reset-password",
      "status": 200,
      "body_kind": "text",
      "body": "Password has been reset successfully"
    },
    {
      "name": "Then the original JWT still permits access to the reader's history",
      "method": "GET",
      "path": "/resource/history",
      "status": 200,
      "body_kind": "json",
      "body": {
        "history": [],
        "timestamp": 0
      }
    }
  ]
}
