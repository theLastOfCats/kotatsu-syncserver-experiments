{
  "story": "observation_invalid_sync_json",
  "steps": [
    {
      "name": "When the phone sends a truncated JSON object",
      "method": "POST",
      "path": "/resource/history",
      "status": 500,
      "body_kind": "text",
      "body": "500: io.ktor.server.plugins.BadRequestException: Failed to convert request body to class org.kotatsu.model.history.HistoryPackage"
    },
    {
      "name": "And when the history field has the wrong JSON type",
      "method": "POST",
      "path": "/resource/history",
      "status": 500,
      "body_kind": "text",
      "body": "500: io.ktor.server.plugins.BadRequestException: Failed to convert request body to class org.kotatsu.model.history.HistoryPackage"
    },
