    {
      "name": "Given an observation reader signs in",
      "method": "POST",
      "path": "/auth",
      "status": 200,
      "body_kind": "json",
      "body": {
        "token": "[REDACTED]"
      }
    },
    {
      "name": "And the reader starts with an empty library",
      "method": "GET",
      "path": "/resource/favourites",
      "status": 200,
      "body_kind": "json",
      "body": {
        "categories": [],
        "favourites": [],
        "timestamp": 0
      }
    },
