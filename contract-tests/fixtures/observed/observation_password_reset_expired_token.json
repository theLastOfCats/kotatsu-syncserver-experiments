{
  "story": "observation_password_reset_expired_token",
  "steps": [
    {
      "name": "Given a reader creates an account",
      "method": "POST",
      "path": "/auth",
      "status": 200,
      "body_kind": "json",
      "body": {
        "token": "[REDACTED]"
      }
    },
    {
      "name": "When the reader requests a reset email",
      "method": "POST",
      "path": "/forgot-password",
      "status": 200,
      "body_kind": "text",
      "body": "A password reset email was sent"
    },
    {
      "name": "Then the delivered token is rejected after its deadline",
      "method": "POST",
      "path": "/reset-password",
      "status": 400,
      "body_kind": "text",
      "body": "Invalid or expired token"
    }
  ]
}
